TELEGRAM_BOT_TOKEN=replace-with-your-botfather-token
# Optional Nimbus Fetch fallback; use the API key of the deployed Nimbus service.
NIMBUS_FETCH_API_KEY=
# Optional Api-Key for the public HTTPS Cobalt endpoint, if required.
COBALT_API_KEY=

# Directory holding *_cookies.txt for Instagram, Facebook and TikTok.
# Instagram Stories are read straight from www.instagram.com_cookies.txt via
# gallery-dl, so no username or password needs to be configured.
SOCIAL_COOKIE_DIR=

# Self-hosted telegram-bot-api server, which lifts the bot upload ceiling from
# 50 MB to roughly 2 GB. Leave unset to use api.telegram.org.
TELEGRAM_API_SERVER_URL=

# Optional zero-copy uploads. A local server only serves file:// paths under
# its own --dir root, so this must be that exact path as seen from the bot
# container -- not the shared temp mount. Leave unset to upload via multipart,
# which works regardless of how the two containers are mounted.
TELEGRAM_API_FILES_DIR=

# Optional: read media from Telegram channels/groups the bot is not a member of.
# Requires the owner's own MTProto session, so these credentials belong to a
# user account, not the bot. The session string is read from the secrets mount
# (see TELEGRAM_MTPROTO_SESSION in compose.home.yaml) and is never logged.
# Use a throwaway account: Telegram may restrict an account seen from a new IP.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
